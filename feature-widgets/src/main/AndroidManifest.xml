<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 11+: ohne diese Angabe gilt die Agent-App immer als nicht installiert. -->
    <queries>
        <package android:name="io.github.ra5on.titanos.agent" />
    </queries>
    <application>
        <receiver android:name="io.github.ra5on.titanos.widgets.NasWidgetReceiver" android:exported="true" android:label="@string/w_nas_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_nas" />
        </receiver>
        <receiver android:name="io.github.ra5on.titanos.widgets.PhotosWidgetReceiver" android:exported="true" android:label="@string/w_photos">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_photos" />
        </receiver>
        <receiver android:name="io.github.ra5on.titanos.widgets.AgentWidgetReceiver" android:exported="true" android:label="@string/w_agent">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agent" />
        </receiver>
    </application>
</manifest>
