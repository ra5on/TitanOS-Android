<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Sicherung und keine Übertragung auf ein neues Gerät: die Kopplung gehört zu diesem Gerät und seinem Keystore-Schlüssel. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
