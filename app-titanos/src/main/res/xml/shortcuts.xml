<?xml version="1.0" encoding="utf-8"?>
<!-- Feste Kurzbefehle am App-Symbol; dazu kommen die zuletzt geöffneten Programme (Shortcuts.kt). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="ask"
        android:enabled="true"
        android:icon="@drawable/ic_sc_agent_round"
        android:shortcutShortLabel="@string/sc_ask"
        android:shortcutLongLabel="@string/sc_ask_long">
        <intent
            android:action="io.github.ra5on.titanos.SHORTCUT"
            android:targetPackage="io.github.ra5on.titanos"
            android:targetClass="io.github.ra5on.titanos.ShortcutActivity">
            <extra android:name="shortcut" android:value="ask" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="upload"
        android:enabled="true"
        android:icon="@drawable/ic_sc_upload_round"
        android:shortcutShortLabel="@string/sc_upload"
        android:shortcutLongLabel="@string/sc_upload_long">
        <intent
            android:action="io.github.ra5on.titanos.SHORTCUT"
            android:targetPackage="io.github.ra5on.titanos"
            android:targetClass="io.github.ra5on.titanos.ShortcutActivity">
            <extra android:name="shortcut" android:value="upload" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="photos"
        android:enabled="true"
        android:icon="@drawable/ic_sc_photo_round"
        android:shortcutShortLabel="@string/sc_photos"
        android:shortcutLongLabel="@string/sc_photos_long">
        <intent
            android:action="io.github.ra5on.titanos.SHORTCUT"
            android:targetPackage="io.github.ra5on.titanos"
            android:targetClass="io.github.ra5on.titanos.ShortcutActivity">
            <extra android:name="shortcut" android:value="photos" />
        </intent>
    </shortcut>
</shortcuts>
