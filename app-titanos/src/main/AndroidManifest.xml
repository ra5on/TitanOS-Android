<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TitanApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TitanOS">
        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Kurzbefehle am App-Symbol (Agent fragen, Hochladen, Fotos sichern). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- „Auf diesem Handy öffnen“: titanos://pair?v=1&c=…&a=…  (docs/ANDROID-APP.md). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="titanos" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- „Teilen → Auf TitanOS speichern“: Dateien aus anderen Apps aufs NAS. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/app_share_label"
            android:icon="@mipmap/ic_launcher"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!--
            mailto: aus anderen Apps öffnet Verfassen in Mail (feature-mail, eigenes Fenster).
            MailWindowActivity selbst bleibt nicht exportiert (ihre Extras sind nur für die App);
            fremde Apps kommen über den Alias, und dort zählen nur mailto: und die EXTRA_*.
            Das Ziel muss vor dem Alias stehen, deshalb hier noch einmal (ohne Änderung).
        -->
        <activity
            android:name="io.github.ra5on.titanos.mail.MailWindowActivity"
            tools:node="merge" />
        <activity-alias
            android:name="io.github.ra5on.titanos.mail.MailtoActivity"
            android:targetActivity="io.github.ra5on.titanos.mail.MailWindowActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mailto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
        </activity-alias>
        <!-- Ziel der Kurzbefehle, ohne eigene Oberfläche (Shortcuts.kt). -->
        <activity
            android:name=".ShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="io.github.ra5on.titanos.SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Welches NAS ein Widget zeigt (android:configure der Widgets NAS-Zustand und Fotos). -->
        <activity
            android:name=".WidgetNasActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Schnelleinstellungen: Foto-Sicherung, NAS-Zustand, Agent fragen (QuickTiles.kt). -->
        <service
            android:name=".PhotoTile"
            android:exported="true"
            android:icon="@drawable/ic_sc_photo"
            android:label="@string/tile_photos"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".NasTile"
            android:exported="true"
            android:icon="@drawable/ic_sc_nas"
            android:label="@string/tile_nas"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".AgentTile"
            android:exported="true"
            android:icon="@drawable/ic_sc_agent"
            android:label="@string/tile_agent"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Gerätesteuerung: Container, VMs und Home Assistant aller gekoppelten NAS (Controls.kt). -->
        <service
            android:name=".TitanControlsService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CONTROLS">
            <intent-filter>
                <action android:name="android.service.controls.ControlsProviderService" />
            </intent-filter>
        </service>
        <!-- WorkManager mit eigener Konfiguration (TitanApp.workManagerConfiguration). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
