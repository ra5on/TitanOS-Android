   "compose": "# Nextcloud mit Datenbank\nx-titanos:\n  main: app\n  icon: https://example.org/nextcloud.png\n  tips:\n    de: Zuerst die Datenbank starten lassen.\n    en: Let the database start first.\n  variables:\n    MYSQL_PASSWORD:\n      label: { de: Datenbank-Passwort, en: Database password }\n      secret: generate\n    NEXTCLOUD_ADMIN_USER:\n      label: Admin\n      required: true\n      placeholder: admin\n    NEXTCLOUD_ADMIN_PASSWORD:\n      secret: true\n      required: true\n    TZ:\n      help: Zeitzone\n  paths:\n    /var/www/html:\n      label: { de: Programm und Daten, en: App and data }\n    /media:\n      label: Medien\n      suggest: media\n  ports:\n    \"80\":\n      label: Weboberfläche\n      webui: true\nservices:\n  db:\n    image: mariadb:11\n    restart: unless-stopped\n    environment:\n      MYSQL_PASSWORD: ${MYSQL_PASSWORD}\n      MYSQL_DATABASE: nextcloud\n    volumes:\n      - \"/mnt/Data/nc:/var/lib/mysql\"\n  app:\n    image: nextcloud:30\n    restart: unless-stopped\n    environment:\n      MYSQL_PASSWORD: ${MYSQL_PASSWORD}\n      MYSQL_HOST: db\n      NEXTCLOUD_ADMIN_USER: chef\n      NEXTCLOUD_ADMIN_PASSWORD: ${NEXTCLOUD_ADMIN_PASSWORD}\n      TZ: Europe/Vienna\n      PUID: \"1000\"\n      EXTRA: \"1\"\n    volumes:\n      - \"./html:/var/www/html\"\n      - \"/mnt/Data/Medien:/media:ro\"\n      - cache:/cache\n      - \"/mnt/Data/x:/x\"\n    ports:\n      - \"8082:80\"\n      - \"3478:3478/udp\"\n      - \"9000:9000\"\n    devices:\n      - /dev/dri:/dev/dri\n      - /dev/net/tun\n    labels:\n      titanos.icon: https://example.org/nextcloud.png\n      a.b: c\n      titanos.webui: \"8082\"\n      titanos.public-url: https://cloud.example.org\n    cpuset: 0-1\n    mem_limit: 2g\n    x-titanos-hardware:\n      - intel-gpu\nvolumes:\n  cache: {}\n",
   "env": {
    "MYSQL_PASSWORD": "GEN_MYSQL_PASSWORD",
    "NEXTCLOUD_ADMIN_PASSWORD": "geheim!"
   },
   "plain": {
    "x-titanos": {
     "main": "app",
     "icon": "https://example.org/nextcloud.png",
     "tips": {
      "de": "Zuerst die Datenbank starten lassen.",
      "en": "Let the database start first."
     },
     "variables": {
      "MYSQL_PASSWORD": {
       "label": {
        "de": "Datenbank-Passwort",
        "en": "Database password"
       },
       "secret": "generate"
      },
      "NEXTCLOUD_ADMIN_USER": {
       "label": "Admin",
       "required": true,
       "placeholder": "admin"
      },
      "NEXTCLOUD_ADMIN_PASSWORD": {
       "secret": true,
       "required": true
      },
      "TZ": {
       "help": "Zeitzone"
      }
     },
     "paths": {
      "/var/www/html": {
       "label": {
        "de": "Programm und Daten",
        "en": "App and data"
       }
      },
      "/media": {
       "label": "Medien",
       "suggest": "media"
      }
     },
     "ports": {
      "80": {
       "label": "Weboberfläche",
       "webui": true
      }
     }
    },
    "services": {
     "db": {
      "image": "mariadb:11",
      "restart": "unless-stopped",
      "environment": {
       "MYSQL_PASSWORD": "${MYSQL_PASSWORD}",
       "MYSQL_DATABASE": "nextcloud"
      },
      "volumes": [
       "/mnt/Data/nc:/var/lib/mysql"
      ]
     },
     "app": {
      "image": "nextcloud:30",
      "restart": "unless-stopped",
      "environment": {
       "MYSQL_PASSWORD": "${MYSQL_PASSWORD}",
       "MYSQL_HOST": "db",
       "NEXTCLOUD_ADMIN_USER": "chef",
       "NEXTCLOUD_ADMIN_PASSWORD": "${NEXTCLOUD_ADMIN_PASSWORD}",
       "TZ": "Europe/Vienna",
       "PUID": "1000",
       "EXTRA": "1"
      },
      "volumes": [
       "./html:/var/www/html",
       "/mnt/Data/Medien:/media:ro",
       "cache:/cache",
       "/mnt/Data/x:/x"
      ],
      "ports": [
       "8082:80",
       "3478:3478/udp",
       "9000:9000"
      ],
      "devices": [
       "/dev/dri:/dev/dri",
       "/dev/net/tun"
      ],
      "labels": {
       "titanos.icon": "https://example.org/nextcloud.png",
       "a.b": "c",
       "titanos.webui": "8082",
       "titanos.public-url": "https://cloud.example.org"
      },
      "cpuset": "0-1",
      "mem_limit": "2g",
      "x-titanos-hardware": [
       "intel-gpu"
      ]
     }
    },
    "volumes": {
     "cache": {}
    }
   },
   "casaPlain": null,
   "hardware": {
    "app": [
     "intel-gpu"
    ],
    "db": []
   }
